root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# GitHub Pages writes this without a trailing newline. Leave it exactly as is:
# it is what points the site at spreadthefuture.com.
[CNAME]
insert_final_newline = false
